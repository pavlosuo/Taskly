{
  "name": "taskly-monorepo",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel -r run dev",
    "dev:web": "pnpm --filter @taskly/web dev",
    "dev:api": "pnpm --filter @taskly/api dev",
    "build": "pnpm --parallel -r run build",
    "build:web": "pnpm --filter @taskly/web build",
    "build:api": "pnpm --filter @taskly/api build",
    "start": "pnpm --parallel -r run start",
    "start:web": "pnpm --filter @taskly/web start",
    "start:api": "pnpm --filter @taskly/api start",
    "lint": "pnpm --filter @taskly/web lint && pnpm --filter @taskly/api lint",
    "typecheck": "pnpm --filter @taskly/web typecheck && pnpm --filter @taskly/api typecheck",
    "zip": "node zip-project.js",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "20.19.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "archiver": "^8.0.0"
  },
  "pnpm": {
    "overrides": {
      "minimatch@>=7.0.0 <11.0.1": "^11.0.1"
    }
  }
}
